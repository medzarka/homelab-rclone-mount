# ========================================================
# Rclone Mount Configuration
# ========================================================

# Container name (optional, defaults to rclone-mount)
CONTAINER_NAME=rclone-mount

# Rclone Remote & Path to mount
# Format: <remote_name>:<remote_path>
# Examples:
#   - seafile:Development
#   - gdrive:MyFolder
#   - nextcloud:Documents
#   - s3:my-bucket/data
RCLONE_REMOTE_PATH=seafile:Development

# Host directory where the remote will be mounted
# Make sure the target directory exists on the host
# Examples:
#   - /srv/data/Development
#   - /srv/data/seafile/Development
#   - /mnt/storage/data
HOST_MOUNT_DIR=/srv/data/Development

# Optional: Base data directory (used as fallback if HOST_MOUNT_DIR is omitted)
DATA_DIR=/srv/data

# Timezone for container logs (e.g. Europe/Paris, America/New_York, UTC)
TZ=UTC

# Log level: DEBUG, INFO, NOTICE, ERROR (defaults to INFO)
RCLONE_LOG_LEVEL=INFO

# Optional: Custom mount options / flags
# Default includes full VFS cache mode with 10GB max size, 24h retention, and 32MB buffer:
# RCLONE_MOUNT_OPTIONS=--vfs-cache-mode full --vfs-cache-max-size 10G --vfs-cache-max-age 24h --allow-other --allow-non-empty --buffer-size 32M

# --- Rclone Configuration Injection ---
# Because Dockhand and some .env parsers break on multi-line text, we use Base64.
# Run this on your local machine to get the Base64 string:
#   cat rclone.conf | base64 -w 0
# (On macOS, use: cat rclone.conf | base64)
# Paste the resulting single-line string here:
RCLONE_CONF_BASE64=""

# --- Optional Config Password (AES-256 Encryption) ---
# If your rclone.conf is encrypted with a password (rclone config -> 's'),
# provide the decryption password here.
# Leave empty if your rclone.conf is in clear mode.
RCLONE_CONFIG_PASS=""
